# The independent rebuild of a web release (web/INTEGRITY.md, "Rebuilding"). Everything the build
# uses is pinned: the base image by digest, Node by tarball hash, wasm-bindgen by version and lock.
# Build context: the output of `git archive <commit>`. Use web/scripts/rebuild-in-container.sh.
FROM --platform=linux/amd64 rust:1.99.0-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6

ARG NODE_VERSION=24.22.1
ARG NODE_SHA256=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
RUN curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/node.tar.xz \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
 && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
 && rm /tmp/node.tar.xz

RUN rustup target add wasm32-unknown-unknown \
 && cargo install wasm-bindgen-cli --version 0.2.117 --locked

WORKDIR /src
COPY . .

ARG PROFILE=testnet
ARG VERSION=0.0.0
ENV PROFILE=${PROFILE} VERSION=${VERSION}
# The rebuild script puts the ceremony's proving keys in ceremony-keys/ (the build checks their hashes).
ENV NYMIRA_SETUP_DIR=/src/ceremony-keys
RUN web/scripts/build-wasm.sh \
 && cd web \
 && npm ci --ignore-scripts \
 && node node_modules/vite/bin/vite.js build --mode "$PROFILE" --outDir "dist-$PROFILE" \
 && node scripts/integrity.mjs assemble --dist "dist-$PROFILE" --meta "dist-$PROFILE-meta" \
      --out "site-$PROFILE" --version "$VERSION" --profile "$PROFILE"
